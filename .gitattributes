# 统一换行为 LF，防止在 Windows 上编辑后又染成 CRLF（历史迁移遗留问题）。
# 默认：文本文件自动识别，仓库内一律以 LF 存储。
* text=auto eol=lf

# 明确指定源码/文本类型走 LF
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.env   text eol=lf
*.bat   text eol=crlf

# 二进制文件不做换行处理
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.pptx  binary
*.xlsx  binary
*.woff  binary
*.woff2 binary
