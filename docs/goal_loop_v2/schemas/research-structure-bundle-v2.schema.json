  "x-document-vs-build": {
    "document_validation": "Checks exact keys, types, references, affine reproducibility, graph consistency and finite geometry while preserving candidate/unresolved states.",
    "build_readiness": "A separate fail-closed gate requires all build-consumed entities and topology to be confirmed, while deliberate evidence_only observations remain hash-bound and unbuilt.",
    "forbidden": "Schema validation or migration must never rewrite candidate/unresolved to confirmed."
  },
  "x-structure-hash": {
    "algorithm": "sha256(canonical_json(payload))",
    "payload_top_level_fields_in_order_independent_object": [
      "schema",
      "project",
      "source_hash",
      "source",
      "outer_boundary",
      "spaces",
      "wall_graph",
      "opening_contract",
      "adjacency_truth",
      "assumptions",
      "unresolved_issues"
    ],
    "excluded": [
      "structure_hash",
      "validation reports",
      "scores and reviews",
      "run IDs and timestamps",
      "artifact paths",
      "migration sidecar report"
    ],
    "array_order_policy": "Before hashing, sort entity arrays by stable ID and sort ID-reference arrays lexicographically; preserve geometric point order and directed branch intervals."
  },
  "x-build-ready-gates": [
    "source_hash equals source.original.file_sha256 and every asset/transform/anchor is reproducible",
    "metric registration refits from non-collinear controls within tolerance and has a nonzero determinant",
    "outer boundary, build-consumed spaces, wall branches/atoms/junctions, cut openings and adjacency edges are confirmed",
    "every wall atom endpoint belongs to exactly one junction incident and every junction incident references the matching endpoint",
    "all T/X relations are atomized; no undeclared crossing, collinear overlap, ghost junction or unresolved interior free end remains",
    "each cut opening has one host atom, one effective void, complete Z basis, two mechanically proven jamb supports and no effective-void overlap",
    "evidence_only/retain_solid observations have no effective void, no build kind and no adjacency edge",
    "exclude_pending_resolution observations and every open issue with blocks_build=true prevent build",
    "all research assumptions referenced by build fields use allow_research_only and are disclosed; construction-grade output remains forbidden",
    "all spaces are reachable from exterior through confirmed traversable door/open-passage edges"
  ],
  "x-opening-gap-rule": {
    "measurement_domain": "effective void intervals projected to their common branch; nominal source segments are never used as build-gap intervals",
    "same_wall_required_contribution_m": 0.05,
    "return_or_cross_required_host_contribution_m": 0.0,
    "rule": "Adjacent effective voids may not overlap. Their retained host gap must be at least the sum of the two facing same-wall contributions. Return/crossing support contributes only after its cited wall/junction solid independently proves at least 0.05 m support and remains uncut by host-scoped subtraction."
  },
  "x-repair-operations": {
    "automatic_structure_scope": [
