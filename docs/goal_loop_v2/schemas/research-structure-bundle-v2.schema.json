  "x-migration": {
    "reader_policy": "Read v1 and v2 concurrently; preserve and validate the original schema and hash without write-back.",
    "upgrade_policy": "A pure v1-to-v2 adapter requires an external canonical source manifest and emits a migration sidecar. It never copies confirmed=true into fields that cannot be recomputed under v2.",
    "fail_closed_conditions": [
      "canonical image hash/dimensions/transform cannot be reconstructed",
      "metric affine cannot be refit from sufficient controls",
      "unsplit T/X or face termination cannot be atomized without changing source geometry",
      "nominal and effective opening geometry cannot be distinguished",
      "jamb support, opening kind, adjacency or Z basis remains unresolved"
    ],
    "hash_policy": "The v1 hash remains immutable. A migrated v2 document receives a new v2 structure hash; migration lineage is kept in a sidecar and does not enter the v2 structure hash."
