{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floor-rendering-engine.local/schema/research-structure-bundle-v2-draft.json",
  "title": "Research Structure Bundle v2 (Stage B architecture draft)",
  "description": "Candidate schema only. It separates lossless reference representation from build readiness and does not confirm unresolved reference facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "source_hash",
    "structure_hash",
    "source",
    "outer_boundary",
    "spaces",
    "wall_graph",
    "opening_contract",
    "adjacency_truth",
    "assumptions",
    "unresolved_issues"
  ],
  "properties": {
    "schema": {
      "const": "research-structure-bundle-v2"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "source_hash": {
      "$ref": "#/$defs/sha256"
    },
    "structure_hash": {
      "$ref": "#/$defs/sha256"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "outer_boundary": {
      "$ref": "#/$defs/outerBoundary"
    },
    "spaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/space"
      }
    },
    "wall_graph": {
      "$ref": "#/$defs/wallGraph"
    },
    "opening_contract": {
      "$ref": "#/$defs/openingContract"
    },
    "adjacency_truth": {
      "$ref": "#/$defs/adjacencyTruth"
    },
    "assumptions": {
      "$ref": "#/$defs/assumptionRegistry"
    },
    "unresolved_issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolvedIssue"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "point2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "segment2": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/point2"
        },
        {
          "$ref": "#/$defs/point2"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "matrix3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 3,
          "maxItems": 3
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "status": {
      "enum": [
        "confirmed",
        "candidate",
        "unresolved",
        "legacy_confirmed"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "revision",
        "sample_id"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/stableId"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "sample_id": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "pixelAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_sha256",
        "pixel_sha256",
        "size_px"
      ],
      "properties": {
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pixel_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_px": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "originalAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_sha256",
        "pixel_sha256",
        "size_px",
        "exif_orientation"
      ],
      "properties": {
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pixel_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_px": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "exif_orientation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "canonicalAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_sha256",
        "pixel_sha256",
        "size_px",
        "orientation_policy",
        "raw_to_canonical_3x3"
      ],
      "properties": {
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pixel_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_px": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "orientation_policy": {
          "enum": [
            "raw_identity",
            "exif_transpose",
            "ignore_invalid_exif_user_confirmed_raw"
          ]
        },
        "raw_to_canonical_3x3": {
          "$ref": "#/$defs/matrix3"
        }
      }
    },
    "sourceView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "file_sha256",
        "pixel_sha256",
        "size_px",
        "canonical_to_view_3x3"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "role": {
          "enum": [
            "normalized_evidence",
            "crop",
            "overlay_base"
          ]
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pixel_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_px": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "canonical_to_view_3x3": {
          "$ref": "#/$defs/matrix3"
        }
      }
    },
    "registrationControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonical_px",
        "metric_m",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "canonical_px": {
          "$ref": "#/$defs/point2"
        },
        "metric_m": {
          "$ref": "#/$defs/point2"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "metricRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "solver",
        "canonical_px_to_metric_3x3",
        "control_points",
        "max_residual_m",
        "tolerance_m",
        "scale_anchor_id"
      ],
      "properties": {
        "model": {
          "const": "affine-2d"
        },
        "solver": {
          "enum": [
            "exact",
            "least_squares"
          ]
        },
        "canonical_px_to_metric_3x3": {
          "$ref": "#/$defs/matrix3"
        },
        "control_points": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/registrationControl"
          }
        },
        "max_residual_m": {
          "type": "number",
          "minimum": 0
        },
        "tolerance_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.001
        },
        "scale_anchor_id": {
          "$ref": "#/$defs/stableId"
        }
      }
    },
    "anchorGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "space",
        "primitive",
        "points_px"
      ],
      "properties": {
        "space": {
          "const": "canonical_px"
        },
        "primitive": {
          "enum": [
            "point",
            "segment",
            "polyline",
            "polygon",
            "bbox"
          ]
        },
        "points_px": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/point2"
          }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "geometry",
        "measured_distance_mm",
        "status",
        "evidence_asset_id",
        "note"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "kind": {
          "enum": [
            "scale",
            "space",
            "entrance",
            "opening",
            "wall_axis",
            "outer_boundary",
            "fixed_feature",
            "ignore",
            "dimension"
          ]
        },
        "geometry": {
          "$ref": "#/$defs/anchorGeometry"
        },
        "measured_distance_mm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "status": {
          "enum": [
            "human_confirmed",
            "source_confirmed",
            "source_candidate",
            "derived_candidate",
            "unresolved",
            "legacy_confirmed"
          ]
        },
        "evidence_asset_id": {
          "$ref": "#/$defs/stableId"
        },
        "note": {
          "$ref": "#/$defs/nonEmptyText"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "original",
        "canonical",
        "views",
        "metric_registration",
        "anchors"
      ],
      "properties": {
        "schema": {
          "const": "source-provenance-v3"
        },
        "original": {
          "$ref": "#/$defs/originalAsset"
        },
        "canonical": {
          "$ref": "#/$defs/canonicalAsset"
        },
        "views": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceView"
          }
        },
        "metric_registration": {
          "$ref": "#/$defs/metricRegistration"
        },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/anchor"
          }
        }
      }
    },
    "outerBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "polygon_m",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "polygon_m": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/point2"
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "point_m",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "point_m": {
          "$ref": "#/$defs/point2"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "wallBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "centerline_m",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "centerline_m": {
          "$ref": "#/$defs/segment2"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "wallAtom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "branch_id",
        "branch_interval",
        "centerline_m",
        "thickness_m",
        "base_m",
        "height_m",
        "left_space_id",
        "right_space_id",
        "start_node_id",
        "end_node_id",
        "status",
        "evidence_refs",
        "assumption_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "branch_id": {
          "$ref": "#/$defs/stableId"
        },
        "branch_interval": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "centerline_m": {
          "$ref": "#/$defs/segment2"
        },
        "thickness_m": {
          "type": "number",
          "minimum": 0.03,
          "maximum": 1
        },
        "base_m": {
          "type": "number"
        },
        "height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "left_space_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "right_space_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_node_id": {
          "$ref": "#/$defs/stableId"
        },
        "end_node_id": {
          "$ref": "#/$defs/stableId"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "assumption_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "junctionIncident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom_id",
        "end",
        "role",
        "attachment",
        "contact_point_m"
      ],
      "properties": {
        "atom_id": {
          "$ref": "#/$defs/stableId"
        },
        "end": {
          "enum": [
            "start",
            "end"
          ]
        },
        "role": {
          "enum": [
            "through",
            "terminating",
            "continuing"
          ]
        },
        "attachment": {
          "enum": [
            "axis",
            "wall_face",
            "free_end"
          ]
        },
        "contact_point_m": {
          "$ref": "#/$defs/point2"
        }
      }
    },
    "junction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "axis_point_m",
        "termination_kind",
        "incidents",
        "solid_union_policy",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "kind": {
          "enum": [
            "endpoint",
            "L",
            "T",
            "X",
            "continuation"
          ]
        },
        "axis_point_m": {
          "$ref": "#/$defs/point2"
        },
        "termination_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "exterior_boundary",
            "intentional_partition_end",
            "source_termination",
            "unresolved",
            null
          ]
        },
        "incidents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/junctionIncident"
          }
        },
        "solid_union_policy": {
          "enum": [
            "cap",
            "union",
            "face_abutment"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "wallGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "branches",
        "atoms",
        "junctions"
      ],
      "properties": {
        "version": {
          "const": "atomic-wall-junction-graph-v2"
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/wallBranch"
          }
        },
        "atoms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/wallAtom"
          }
        },
        "junctions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/junction"
          }
        }
      }
    },
    "sourceOpeningObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "nominal_segment_m",
        "nominal_width_m",
        "anchor_id",
        "evidence_refs",
        "status"
      ],
      "properties": {
        "kind": {
          "enum": [
            "entrance_symbol",
            "door",
            "window",
            "glazed_access_door",
            "glazed_interface",
            "open_passage",
            "unknown"
          ]
        },
        "nominal_segment_m": {
          "$ref": "#/$defs/segment2"
        },
        "nominal_width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "anchor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "effectiveVoid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_m",
        "width_m",
        "sill_m",
        "head_m",
        "host_cut_scope",
        "status"
      ],
      "properties": {
        "segment_m": {
          "$ref": "#/$defs/segment2"
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sill_m": {
          "type": "number"
        },
        "head_m": {
          "type": "number"
        },
        "host_cut_scope": {
          "const": "owning_wall_atom_only"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "jambSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "supporting_atom_ids",
        "junction_id",
        "face_distance_m",
        "effective_support_m",
        "evidence_refs",
        "status"
      ],
      "properties": {
        "mode": {
          "enum": [
            "same_wall_solid",
            "return_wall_face",
            "crossing_wall_jamb"
          ]
        },
        "supporting_atom_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "junction_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "face_distance_m": {
          "type": "number",
          "minimum": 0
        },
        "effective_support_m": {
          "type": "number",
          "minimum": 0
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_observation",
        "build_disposition",
        "build_kind",
        "owning_wall_atom_id",
        "effective_void",
        "swing_direction",
        "traversable",
        "side_a_space_id",
        "side_b_space_id",
        "jamb_before",
        "jamb_after",
        "status",
        "assumption_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "source_observation": {
          "$ref": "#/$defs/sourceOpeningObservation"
        },
        "build_disposition": {
          "enum": [
            "cut",
            "retain_solid",
            "evidence_only",
            "exclude_pending_resolution"
          ]
        },
        "build_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "entrance",
            "door",
            "window",
            null
          ]
        },
